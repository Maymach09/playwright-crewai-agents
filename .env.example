# API Mode Configuration
# Set to 'demo' for simulated agents (no API key needed)
# Set to 'real' to use actual AI agents (requires API key)
API_MODE=demo

# OpenAI API Configuration (only needed if API_MODE=real)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration (optional, only if API_MODE=real)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (optional, only if API_MODE=real)
GROQ_API_KEY=your_groq_api_key_here

# Application Configuration
LOG_LEVEL=INFO
MAX_ITERATIONS=10
MAX_EXECUTION_TIME=600

# Playwright Configuration
HEADLESS=false
BROWSER=chromium
